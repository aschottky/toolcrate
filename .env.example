OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
PORT=4000

# Local dev — test Payment Link (in .env only, not .env.production)
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_14A289aOrcr78Mx4gn1Fe00

# Production live link is set in .env.production (used by npm run deploy)

# Stripe keys — test vars have TEST prefix; live vars use plain names (no LIVE prefix)
#
# Local `npm run dev`  → TEST mode (STRIPE_TEST_* keys + test price IDs in Stripe Dashboard)
# Render production  → LIVE mode (STRIPE_SECRET_KEY + STRIPE_PUBLISHABLE_KEY + live price IDs)
STRIPE_TEST_SECRET_KEY=sk_test_your-secret-key
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_live_your-secret-key
STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key
# Optional override — embedded checkout needs >= 2026-03-25.dahlia (default: 2026-04-22.dahlia)
# STRIPE_API_VERSION=2026-04-22.dahlia
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx  # From Stripe Dashboard → Webhooks

# $9 "New Design Variation" price (Dashboard → Products) — used by /api/variation-checkout
STRIPE_VARIATION_PRICE_ID=price_your-variation-price-id

# Full Build + Conversion OS embedded checkout (/api/checkout/create-session)
# Local dev: omit DOMAIN (uses http://localhost:5173) or set DOMAIN=http://localhost:5173
# Production (Render): DOMAIN=https://usetoolcrate.com
# Live prices (Render only):
# STRIPE_PRICE_FULL_BUILD_SETUP=price_your-live-full-build-setup-id
# STRIPE_PRICE_FULL_BUILD_RECURRING=price_your-live-full-build-recurring-id
# STRIPE_PRICE_CONVERSION_OS_SETUP=price_your-live-conversion-os-setup-id
# STRIPE_PRICE_CONVERSION_OS_RECURRING=price_your-live-conversion-os-recurring-id
# Test prices (local .env only):
# STRIPE_PRICE_TEST_FULL_BUILD_SETUP=price_your-test-full-build-setup-id
# STRIPE_PRICE_TEST_FULL_BUILD_RECURRING=price_your-test-full-build-recurring-id
# STRIPE_PRICE_TEST_CONVERSION_OS_SETUP=price_your-test-conversion-os-setup-id
# STRIPE_PRICE_TEST_CONVERSION_OS_RECURRING=price_your-test-conversion-os-recurring-id

# After payment, set Stripe Payment Link redirect (Dashboard) to:
#   Local test: http://localhost:5173/scan/?success=true&session_id={CHECKOUT_SESSION_ID}
#   Production:  https://usetoolcrate.com/scan/?success=true&session_id={CHECKOUT_SESSION_ID}

# Production API (set in .env.production — see docs/deploy.md)
# VITE_API_BASE_URL=https://toolcrate-backend-500j.onrender.com

# Supabase (Project Settings → API — use service_role key on server only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cron — protect POST /api/cron/process-nurture (generate a long random string)
CRON_SECRET=your-long-random-cron-secret

# Instantly.ai — protect POST /api/webhooks/instantly (Authorization: Bearer … or ?secret=)
INSTANTLY_WEBHOOK_SECRET=your-long-random-instantly-webhook-secret
CONVERSION_OS_BOOKING_URL=https://calendly.com/your-booking-link

# Anthropic — redesign generation (Claude Sonnet) + site roast (Claude Opus)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional override (default: claude-sonnet-5). Do NOT use claude-3-5-sonnet-20240620 — retired.
# CLAUDE_REDESIGN_MODEL=claude-sonnet-5

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxx
# Optional: improves scrape success on Cloudflare-protected sites (https://jina.ai/reader)
# JINA_API_KEY=jina_your-api-key
# From address (usetoolcrate.com verified in Resend)
RESEND_FROM_EMAIL=Alexander <alexander@usetoolcrate.com>
# Where /try submissions notify Alexander (defaults to alexschottky@gmail.com)
# PREVIEW_NOTIFY_EMAIL=alexschottky@gmail.com
