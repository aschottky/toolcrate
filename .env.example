OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
PORT=4000

# Local dev — test Payment Link (in .env only, not .env.production)
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_14A289aOrcr78Mx4gn1Fe00

# Production live link is set in .env.production (used by npm run deploy)

# Stripe server keys (Dashboard → Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# After payment, set Stripe Payment Link redirect (Dashboard) to:
#   Local test: http://localhost:5173/?success=true&session_id={CHECKOUT_SESSION_ID}
#   Production:  https://usetoolcrate.com/?success=true&session_id={CHECKOUT_SESSION_ID}

# Production API (set in .env.production — see docs/deploy.md)
# VITE_API_BASE_URL=https://toolcrate-api.onrender.com

# Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_your-api-key
# Use onboarding@resend.dev for testing, or your verified domain:
# RESEND_FROM_EMAIL=Website Tear Down <reports@yourdomain.com>
