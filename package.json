{
  "name": "toolcrate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Website Tear Down — $17 AI site audit landing page",
  "scripts": {
    "dev": "concurrently -n client,api -c cyan,magenta \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "build": "vite build",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "start": "node server/index.js",
    "start:server": "node --env-file=.env server/index.js",
    "deploy": "npm run build:production && touch dist/.nojekyll && gh-pages -d dist -t"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "openai": "^4.104.0",
    "pdfkit": "^0.18.0",
    "resend": "^6.12.4",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "gh-pages": "^6.3.0",
    "vite": "^6.3.5"
  }
}
